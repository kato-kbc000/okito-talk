# コピーして .env にしてください（.env は Git に入れないこと）
SUPABASE_URL=https://xxxxxxxx.supabase.co
# フロントと同じ Publishable (anon) key。service_role キーは不要です。
SUPABASE_KEY=sb_publishable_xxxxxxxx
# 住所検索をサーバー経由にする場合のみ。Google Cloud で Geocoding API を有効にした「サーバー用キー」。
# 未設定なら OpenStreetMap(Nominatim) だけで検索します。
GOOGLE_GEOCODING_KEY=
# フロントを別ドメインで配信する場合だけカンマ区切りで指定（同じサーバーで配信するなら不要）
CORS_ORIGINS=
